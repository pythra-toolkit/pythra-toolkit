#!/usr/bin/env bash
set -euo pipefail

# Git passes the path to the temporary commit message file as $1
msgfile="$1"

marker="--- Commit metadata ---"

# If metadata already present, do nothing
if grep -qF "$marker" "$msgfile"; then
  exit 0
fi

hostname_val=$(hostname -f 2>/dev/null || hostname)
os_val="$(uname -s) $(uname -r)"
user_val="${USER:-$(whoami 2>/dev/null || echo unknown)}"

# ISO 8601 date-time; fall back for platforms without --iso-8601
if date --iso-8601=seconds >/dev/null 2>&1; then
  datetime=$(date --iso-8601=seconds)
else
  datetime=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
fi

cat >> "$msgfile" <<EOF

$marker
Device: $hostname_val
OS: $os_val
User: $user_val
Date: $datetime
EOF

exit 0
